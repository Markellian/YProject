<Window x:Class="Cinema.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cinema"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" ResizeMode="NoResize">
    <Window.Resources>
        <DataTemplate x:Key="BuyButton">
            <Button Content="Купить" 
            Width="80" 
            Height="30" 
            Padding="5,2"
            FontSize="11"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Click="GoToChoosePlacesGrid"/>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid x:Name="RegistrationGrid" Style="{StaticResource CinemaBackgroundGrid}" Visibility="Hidden" IsVisibleChanged="RegistrationGrid_IsVisibleChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="4*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Регистрация" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,283.6,0" FontSize="24" Grid.Column="1" Foreground="#C41E3A" FontWeight="Bold"/>
            <Label Content="Логин" Style="{StaticResource CinemaLabel}" HorizontalAlignment="Right" Margin="0,80,10,0" FontSize="20" VerticalAlignment="Top" Height="40"/>
            <Label Content="Пароль" Style="{StaticResource CinemaLabel}" HorizontalAlignment="Right" Margin="0,130,10,0" FontSize="20" VerticalAlignment="Top" Height="40"/>
            <Label Content="Повторите пароль" Style="{StaticResource CinemaLabel}" HorizontalAlignment="Right" Margin="0,180,10,0" FontSize="20" VerticalAlignment="Top" Height="40"/>
            <Label Content="Фамилия" Style="{StaticResource CinemaLabel}" HorizontalAlignment="Right" Margin="0,230,10,0" FontSize="20" VerticalAlignment="Top" Height="40"/>
            <Label Content="Имя" Style="{StaticResource CinemaLabel}" HorizontalAlignment="Right" Margin="0,280,10,0" FontSize="20" VerticalAlignment="Top" Height="40"/>
            <TextBox x:Name="LoginRegistrationTextBox" Style="{StaticResource CinemaTextBox}" Grid.Column="1" MaxLength="30" HorizontalAlignment="Left" Margin="0,80,0,0" VerticalContentAlignment="Center" TextWrapping="Wrap" FontSize="20" Height="40" VerticalAlignment="Top" Width="180"/>
            <PasswordBox x:Name="PasswordRegistrationPasswordBox" Style="{StaticResource CinemaPasswordBox}" Grid.Column="1" MaxLength="20" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,130,0,0" VerticalContentAlignment="Center" FontSize="20" Height="40" Width="180"/>
            <PasswordBox x:Name="PasswordRegistration2PasswordBox" Style="{StaticResource CinemaPasswordBox}" Grid.Column="1" MaxLength="20" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,180,0,0" VerticalContentAlignment="Center" FontSize="20" Height="40" Width="180"/>
            <TextBox x:Name="LastNameRegistrationTextBox" Style="{StaticResource CinemaTextBox}" Grid.Column="1" MaxLength="25" HorizontalAlignment="Left" Margin="0,230,0,0" VerticalContentAlignment="Center" TextWrapping="Wrap" FontSize="20" Height="40" VerticalAlignment="Top" Width="180"/>
            <TextBox x:Name="FirstNameRegistrationTextBox" Style="{StaticResource CinemaTextBox}" Grid.Column="1" MaxLength="25" HorizontalAlignment="Left" Margin="0,280,0,0" VerticalContentAlignment="Center" TextWrapping="Wrap" FontSize="20" Height="40" VerticalAlignment="Top" Width="180"/>
            <Button Content="Зарегистрироваться" Style="{StaticResource CinemaButton}" FontSize="20" HorizontalAlignment="Left" Margin="307,352,0,0" VerticalAlignment="Top" Width="213" Grid.ColumnSpan="2" Click="RegistrationUserButton_Click"/>
            <Button Content="Назад" Style="{StaticResource CinemaButton}" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Width="75" Click="BackToAuth"/>
        </Grid>

        <Grid x:Name="ListPosterGrid" Style="{StaticResource CinemaBackgroundGrid}" Visibility="Visible">
            <Border Background="#C41E3A" VerticalAlignment="Top" Height="80" Margin="0,0,-0.4,0">
                <TextBlock Text="Киноафиша" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="30" FontFamily="Lucida Handwriting" TextAlignment="Center"/>
            </Border>
            <Button x:Name="AuthUserButton" Style="{StaticResource CinemaButton}" Visibility="Visible" IsEnabled="True" Content="Войти" Margin="697,10,16,0" VerticalAlignment="Top" Background="White" Click="GoToAuthButton_Click"/>
            <Button x:Name="UserButton" Style="{StaticResource CinemaButton}" Click="UserButton_Click" Content="fff" Visibility="Hidden" HorizontalAlignment="Right" Margin="0,4,128,0" VerticalAlignment="Top" Width="131"/>
            <ScrollViewer Margin="0,85,-0.4,0">
                <Grid x:Name="PosterGrid"/>
            </ScrollViewer>
            <Button x:Name="AddNewFilmButton" Style="{StaticResource CinemaButton}" Content="Добавить" Visibility="Hidden" HorizontalAlignment="Right" Margin="0,40,10,0" VerticalAlignment="Top" Width="113" Click="FromMenuToAddFilm"/>
            <Button x:Name="UsersRoleButton" Style="{StaticResource CinemaButton}" Visibility="Hidden" Content="Пользователи" HorizontalAlignment="Right" Margin="0,3,10,0" VerticalAlignment="Top" Width="113" Click="GoToUsersRoleGrid"/>
        </Grid>

        <Grid x:Name="FilmInformationGrid" Style="{StaticResource CinemaBackgroundGrid}" Visibility="Hidden" IsVisibleChanged="FilmInformationGrid_IsVisibleChanged">
            <Label Content="Расписание сеансов" Style="{StaticResource CinemaLabel}" Foreground="White" VerticalAlignment="Top" Height="80" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="30" Background="#C41E3A" FontFamily="Lucida Handwriting" Margin="0,0,-0.4,0"/>
            <Button Visibility="Visible" x:Name="GoToPostersGridButton" Style="{StaticResource CinemaButton}" Content="Назад" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Width="88" Click="GoToPosterGrid"/>

            <Image Stretch="Fill" x:Name="FilmInformationPosterImage" HorizontalAlignment="Left" Height="176" Margin="23,134,0,0" VerticalAlignment="Top" Width="135"/>
            <TextBlock x:Name="FilmInformationNameTextBlock" FontSize="26" TextAlignment="Center" Margin="0,80,-0.4,0" TextWrapping="Wrap" Text="Название фильма" VerticalAlignment="Top"/>
            <Label Content="Длительность: " Style="{StaticResource CinemaLabel}" FontSize="18" HorizontalAlignment="Left" Margin="163,120,0,0" VerticalAlignment="Top"/>
            <Label x:Name="FilmInformationDurationLabel" Style="{StaticResource CinemaLabel}" Content="" FontSize="18" HorizontalAlignment="Left" Margin="318,134,0,0" VerticalAlignment="Top"/>
            <TextBlock x:Name="FilmInformationDescriptionTextBlock" FontSize="14" HorizontalAlignment="Left" Margin="163,158,0,0" TextWrapping="Wrap" Text="Информация о фильме" VerticalAlignment="Top" Height="110" Width="604"/>
            <DataGrid Margin="0,315,-0.2,0" Name="FilmInformationSessionDataGrid" MaxHeight="300" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Время" Binding="{Binding Path=Time}" Width="0.2*"/>
                    <DataGridTextColumn Header="Цена" Binding="{Binding Path=Price}" Width="*"/>
                    <DataGridTextColumn Header="Номер зала" Binding="{Binding Path=Hall}" Width="0.2*"/>
                    <DataGridTemplateColumn Header="Купить" CellTemplate="{StaticResource BuyButton}" Width="0.2*"/>
                </DataGrid.Columns>
            </DataGrid>
            <Button x:Name="SessionSetupButton" Style="{StaticResource CinemaButton}" Visibility="Hidden" Content="Настройка сеансов" HorizontalAlignment="Left" Margin="640,43,0,0" VerticalAlignment="Top" Width="144" Click="SessionSetupButton_Click"/>
            <Button x:Name="UsersRoleButton2" Style="{StaticResource CinemaButton}" Visibility="Hidden" Content="Пользователи" HorizontalAlignment="Right" Margin="0,4,16,0" VerticalAlignment="Top" Width="144" Click="GoToUsersRoleGrid"/>
            <Button x:Name="AuthUserButton2" Style="{StaticResource CinemaButton}" Visibility="Visible" IsEnabled="True" Content="Войти" HorizontalAlignment="Left" Margin="697,10,0,0" VerticalAlignment="Top" Width="87" Background="White" Click="GoToAuthButton_Click"/>
            <Button x:Name="UserButton2" Style="{StaticResource CinemaButton}" Click="UserButton_Click" Content="" Visibility="Hidden" HorizontalAlignment="Right" Margin="0,4,165,0" VerticalAlignment="Top" Width="139"/>
            <DatePicker Name="DateSessionDataPicker" SelectedDateChanged="DatePicker_SelectedDateChanged" HorizontalAlignment="Left" Margin="163,273,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.397,0.466"/>
        </Grid>

        <Grid x:Name="PlacesGrid"  Visibility="Hidden" Background="Black" Height="434" VerticalAlignment="Top">
            <Label Content="Выбранные билеты:" Style="{StaticResource CinemaLabel}" FontSize="20" Foreground="White" HorizontalAlignment="Left" Margin="513,10,0,0" VerticalAlignment="Top" Height="37" Width="200"/>
            <ScrollViewer Margin="513,47,81,103">
                <TextBlock FontSize="18" Foreground="White" x:Name="ListChoosedPlacesTextBlock" TextWrapping="Wrap"/>
            </ScrollViewer>
            <Label x:Name="AmountLabel" Style="{StaticResource CinemaLabel}" Content="0" HorizontalContentAlignment="Left" Foreground="White" FontSize="18" HorizontalAlignment="Left" Margin="586,322,0,0" VerticalAlignment="Top" Width="109"/>
            <Label Content="Сумма:" Style="{StaticResource CinemaLabel}" Foreground="White" FontSize="18" HorizontalContentAlignment="Right" HorizontalAlignment="Left" Margin="513,322,0,0" VerticalAlignment="Top" Width="68"/>
            <Button Content="Назад" Style="{StaticResource CinemaButton}" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Width="66" Click="GoToFilmInformationFromChoosePlaces"/>
            <Button Content="Купить" Style="{StaticResource CinemaButton}" FontSize="17" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Left" Margin="328,371,0,24" Width="125" Click="GoToPayTickets"/>

        </Grid>
        <Grid x:Name="AuthGrid" Style="{StaticResource CinemaBackgroundGrid}" Visibility="Hidden" IsVisibleChanged="AuthGrid_IsVisibleChanged">
            <TextBlock Text="Авторизация" FontSize="40" HorizontalAlignment="Left" Margin="263,56,0,0" VerticalAlignment="Top" />
            <Button Content="Назад" Style="{StaticResource CinemaButton}" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Width="75" Click="BackFromAuth"/>
            <TextBox x:Name="AuthLoginTextBox" HorizontalAlignment="Left" FontSize="20" Height="37" Margin="334,166,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="179"/>
            <Label Content="Логин" Style="{StaticResource CinemaLabel}" FontSize="20" HorizontalAlignment="Left" Margin="263,166,0,0" VerticalAlignment="Top"/>
            <Label Content="Пароль" Style="{StaticResource CinemaLabel}" FontSize="20" HorizontalAlignment="Left" Margin="250,208,0,0" VerticalAlignment="Top"/>
            <PasswordBox x:Name="AuthPasswordPasswordBox" HorizontalAlignment="Left" FontSize="20" Margin="334,208,0,0" VerticalAlignment="Top" Height="37" Width="179"/>
            <Button Content="Войти" Style="{StaticResource CinemaButton}" FontSize="20" HorizontalAlignment="Left" Margin="418,279,0,0" VerticalAlignment="Top" Width="75" Click="AuthButton_Click"/>
            <Button Content="Регистрация" Style="{StaticResource CinemaButton}" FontSize="20" HorizontalAlignment="Left" Margin="275,279,0,0" VerticalAlignment="Top" Click="GoToRegistration"/>
        </Grid>
        <Grid x:Name="UserGrid" Style="{StaticResource CinemaBackgroundGrid}" Visibility="Hidden">
            <Button Content="Назад" Style="{StaticResource CinemaButton}" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Width="75" Click="GoOutFromUserGrid"/>
            <Button Content="Выйти" Style="{StaticResource CinemaButton}" HorizontalAlignment="Left" Margin="709,10,0,0" VerticalAlignment="Top" Width="75" Click="ExitFromUser"/>
            <TextBlock Text="Мои билеты" FontSize="40" HorizontalAlignment="Left" Margin="269,10,0,0" VerticalAlignment="Top"/>
            <DataGrid x:Name="PursheDetailsDataGrid" IsReadOnly="True" AutoGenerateColumns="False" HorizontalAlignment="Left" Height="333" Margin="0,87,-0.4,0" VerticalAlignment="Top" Width="794">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Номер покупки" Binding="{Binding Path=Purchase_id}"/>
                    <DataGridTextColumn Header="Дата покупки" Binding="{Binding Path=Purchase_date}"/>
                    <DataGridTextColumn Header="Время сеанса" Binding="{Binding Path=Session_time}"/>
                    <DataGridTextColumn Header="Цена билета" Binding="{Binding Path=Price}"/>
                    <DataGridTextColumn Header="Номер зала" Binding="{Binding Path=Hall}"/>
                    <DataGridTextColumn Header="Номер места" Binding="{Binding Path=Place_number}"/>
                    <DataGridTextColumn Header="Номер ряда" Binding="{Binding Path=Row_number}"/>
                    <DataGridTextColumn Header="Название фильма" Binding="{Binding Path=Film_name}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
        <Grid x:Name="PayGrid" Style="{StaticResource CinemaBackgroundGrid}" Visibility="Hidden" IsVisibleChanged="PayGrid_IsVisibleChanged">
            <TextBlock Text="Оплата" FontSize="40" HorizontalAlignment="Left" Margin="309,21,0,0" VerticalAlignment="Top"/>
            <TextBox Name="PayNumberCardTextBox1" TextChanged="PayNumberCardTextBox1_TextChanged" HorizontalAlignment="Left" MaxLength="4" FontSize="18" Height="28" Margin="325,134,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="59"/>
            <TextBox Name="PayNumberCardTextBox2" TextChanged="PayNumberCardTextBox1_TextChanged" HorizontalAlignment="Left" MaxLength="4" FontSize="18" Height="28" Margin="389,134,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="59"/>
            <TextBox Name="PayNumberCardTextBox3" TextChanged="PayNumberCardTextBox1_TextChanged" HorizontalAlignment="Left" MaxLength="4" FontSize="18" Height="28" Margin="453,134,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="59"/>
            <TextBox Name="PayNumberCardTextBox4" HorizontalAlignment="Left" MaxLength="4" FontSize="18" Height="28" Margin="517,134,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="59"/>
            <Label Content="Номер карты:" Style="{StaticResource CinemaLabel}" FontSize="18" HorizontalAlignment="Left" Margin="228,129,0,0" VerticalAlignment="Top"/>
            <Label Content="ММ/ГГ:" Style="{StaticResource CinemaLabel}" FontSize="18" HorizontalAlignment="Left" Margin="271,170,0,0" VerticalAlignment="Top"/>
            <TextBox x:Name="PayMonthCardTextBox" HorizontalAlignment="Left" MaxLength="2" FontSize="18" Height="28" Margin="325,174,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="39"/>
            <Label Content="/" Style="{StaticResource CinemaLabel}" FontSize="18" HorizontalAlignment="Left" Margin="365,171,0,0" VerticalAlignment="Top" Height="34" Width="7" RenderTransformOrigin="1.062,0.494"/>
            <TextBox x:Name="PayYearCardTextBox" HorizontalAlignment="Left" MaxLength="2" FontSize="18" Height="28" Margin="372,174,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="39"/>
            <TextBox x:Name="PayUserCardTextBox" HorizontalAlignment="Left" Height="29" FontSize="18" Margin="325,207,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="148"/>
            <Label Content="Владелец карты:" Style="{StaticResource CinemaLabel}" FontSize="18" HorizontalAlignment="Left" Margin="210,206,0,0" VerticalAlignment="Top"/>
            <Label Content="CVC2:" Style="{StaticResource CinemaLabel}" FontSize="18" HorizontalAlignment="Left" Margin="283,242,0,0" VerticalAlignment="Top"/>
            <TextBox x:Name="PayCVC2CardTextBox" HorizontalAlignment="Left" MaxLength="3" FontSize="18" Height="29" Margin="325,246,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="52"/>
            <Button Content="Назад" Style="{StaticResource CinemaButton}" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Width="75" Click="FromPayToMenu"/>
            <Button Content="Оплатить" Style="{StaticResource CinemaButton}" HorizontalAlignment="Left" Margin="309,328,0,0" VerticalAlignment="Top" Width="75" Click="PayTickets"/>

        </Grid>
        <Grid x:Name="FilmAddGrid" Style="{StaticResource CinemaBackgroundGrid}" Visibility="Hidden" IsVisibleChanged="FilmAddGrid_IsVisibleChanged" Height="434" VerticalAlignment="Top">
            <TextBlock Text="Добавить фильм" FontSize="40" HorizontalAlignment="Left" Margin="226,10,0,0" VerticalAlignment="Top"/>
            <Button Content="Назад" Style="{StaticResource CinemaButton}" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Width="75" Click="FromAddFilmToManu"/>
            <Label Content="Название фильма:" Style="{StaticResource CinemaLabel}" FontSize="18" HorizontalAlignment="Left" Margin="197,102,0,0" VerticalAlignment="Top"/>
            <Label Content="Дата релиза:" Style="{StaticResource CinemaLabel}" FontSize="18" HorizontalAlignment="Left" Margin="235,140,0,0" VerticalAlignment="Top"/>
            <Label Content="Дата окончания показа фильма:" Style="{StaticResource CinemaLabel}" FontSize="18" HorizontalAlignment="Left" Margin="105,179,0,0" VerticalAlignment="Top"/>
            <Label Content="Длительность:" Style="{StaticResource CinemaLabel}" FontSize="18" HorizontalAlignment="Left" Margin="223,218,0,0" VerticalAlignment="Top"/>
            <Label Content="Описание:" Style="{StaticResource CinemaLabel}" FontSize="18" HorizontalAlignment="Left" Margin="249,270,0,0" VerticalAlignment="Top"/>
            <TextBox x:Name="NewFilmNameTextBox" FontSize="18" MaxLength="50" VerticalContentAlignment="Center" HorizontalAlignment="Left" Height="34" Margin="324,101,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="200"/>
            <DatePicker Name="NewFilmDateReleaseDatePicker" HorizontalAlignment="Left" FontSize="18" Margin="325,140,0,0" VerticalAlignment="Top" Width="199"/>
            <DatePicker Name="NewFilmDateEndDatePicker" HorizontalAlignment="Left" FontSize="18" Margin="325,179,0,0" VerticalAlignment="Top" Width="199"/>
            <TextBox x:Name="NewFilmDurationHourTextBox" HorizontalAlignment="Left" MaxLength="2" VerticalContentAlignment="Center" FontSize="18" Height="34" Margin="325,218,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="34"/>
            <Label Content="ч" Style="{StaticResource CinemaLabel}" FontSize="18" HorizontalAlignment="Left" Margin="359,217,0,0" VerticalAlignment="Top"/>
            <Label Content="мин" Style="{StaticResource CinemaLabel}" FontSize="18" HorizontalAlignment="Left" Margin="419,217,0,0" VerticalAlignment="Top"/>
            <TextBox x:Name="NewFilmDurationMinuteTextBox" HorizontalAlignment="Left" FontSize="18" Height="34" Margin="372,217,0,0" TextWrapping="Wrap" Text="" MaxLength="2" VerticalContentAlignment="Center" VerticalAlignment="Top" Width="47"/>
            <TextBox x:Name="NewFilmDescriptionTextBox" HorizontalAlignment="Left" MaxLength="255" FontSize="18" Height="68" Margin="325,280,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="430"/>
            <Button Content="Добавить постер" HorizontalAlignment="Left" Margin="621,238,0,0" VerticalAlignment="Top" Width="134" Click="AddPosterNewFilm"/>
            <Label Name="NewFilmPosterLabel" Content="" BorderBrush="Black" BorderThickness="2" HorizontalAlignment="Left" Margin="621,73,0,0" VerticalAlignment="Top" Height="160" Width="134"/>
            <Button Content="Добавть фильм" HorizontalAlignment="Center" Margin="0,353,0,44" Width="140" MinHeight="35" Click="AddNewFilm"/>

        </Grid>
        <Grid x:Name="UsersRoleGrid" Style="{StaticResource CinemaBackgroundGrid}" Visibility="Hidden">
            <TextBlock Text="Пользователи" FontSize="40" HorizontalAlignment="Left" Margin="242,10,0,0" VerticalAlignment="Top"/>
            <Button Content="Назад" Style="{StaticResource CinemaButton}" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Width="75" Click="GoBackFromUsersRoleGrid"/>
            <DataGrid x:Name="UsersRoleDataGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HorizontalAlignment="Left" Height="314" Margin="10,96,0,0" VerticalAlignment="Top" Width="548">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Логин" Binding="{Binding Path=Login}" Width="*"/>
                    <DataGridTextColumn Header="Роль" Binding="{Binding Path=Role}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <Button x:Name="ChangeRoleOnAdminButton" Style="{StaticResource CinemaButton}" Content="Администратор" HorizontalAlignment="Left" Margin="622,167,0,0" VerticalAlignment="Top" Width="136" Click="ChangeUserRole"/>
            <Button Content="Посетитель" Style="{StaticResource CinemaButton}" HorizontalAlignment="Left" Margin="622,209,0,0" VerticalAlignment="Top" Width="136" Click="ChangeUserRole"/>
            <TextBlock HorizontalAlignment="Left" TextAlignment="Center" Margin="604,138,0,0" TextWrapping="Wrap" FontSize="18" Text="Изменить роль на:" VerticalAlignment="Top" Width="172"/>

        </Grid>
        <Grid x:Name="SessionSetupGrid" Style="{StaticResource CinemaBackgroundGrid}"  Visibility="Hidden" IsVisibleChanged="SessionSetupGrid_IsVisibleChanged">
            <TextBlock Text="Сеансы" FontSize="40" HorizontalAlignment="Left" Margin="305,10,0,0" VerticalAlignment="Top"/>
            <Button Content="Назад" Style="{StaticResource CinemaButton}" HorizontalAlignment="Left" VerticalAlignment="Top" Width="75" Margin="10,10,0,0" Click="GoBackFromSessionSetup"/>
            <DataGrid x:Name="SessionsDataGrid" CanUserAddRows="False" IsReadOnly="True" AutoGenerateColumns="False" HorizontalAlignment="Left" Height="315" Margin="10,95,0,0" VerticalAlignment="Top" Width="653">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Время" Binding="{Binding Path=Session_time}"/>
                    <DataGridTextColumn Header="Цена" Binding="{Binding Path=Price}"/>
                    <DataGridTextColumn Header="Номер зала" Binding="{Binding Path=Hall}"/>
                    <DataGridTextColumn Header="Фильм" Binding="{Binding Path=Film}" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
            <Button Content="Добавить" Style="{StaticResource CinemaButton}" HorizontalAlignment="Left" Margin="668,147,0,0" VerticalAlignment="Top" Width="116" Click="GoToAddSessionGrid"/>
            <Button Content="Удалить" Style="{StaticResource CinemaButton}" HorizontalAlignment="Left" Margin="668,189,0,0" VerticalAlignment="Top" Width="116" Click="DeleteSessionButton_Click"/>

        </Grid>
        <Grid x:Name="AddSessionGrid" Style="{StaticResource CinemaBackgroundGrid}" IsVisibleChanged="AddSessionGrid_IsVisibleChanged" Visibility="Hidden">
            <TextBlock Text="Добавить сеанс для фильма" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0"/>
            <Label x:Name="AddSessionFilmNameLabel" Style="{StaticResource CinemaLabel}" Content="FilmName" HorizontalAlignment="Center" FontSize="30" Margin="324,65,325.6,0" VerticalAlignment="Top"/>
            <Label Content="Дата:" FontSize="20" Style="{StaticResource CinemaLabel}" HorizontalAlignment="Left" Margin="328,120,0,0" VerticalAlignment="Top"/>
            <DatePicker x:Name="AddSessionDataPicker" SelectedDateChanged="AddSessionDataPicker_SelectedDateChanged" HorizontalAlignment="Left" FontSize="20" Margin="367,120,0,0" VerticalAlignment="Top"/>
            <Label Content="Время:" Style="{StaticResource CinemaLabel}" FontSize="20" HorizontalAlignment="Left" Margin="317,162,0,0" VerticalAlignment="Top"/>
            <TextBox TextChanged="AddSessionHourTextBox_TextChanged" Style="{StaticResource CinemaTextBox}" x:Name="AddSessionHourTextBox" IsEnabled="False" HorizontalAlignment="Left" MaxLength="2" VerticalContentAlignment="Center" FontSize="18" Height="34" Margin="367,162,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="32"/>
            <Label Content="ч" Style="{StaticResource CinemaLabel}" FontSize="18" HorizontalAlignment="Left" Margin="399,163,0,0" VerticalAlignment="Top"/>
            <Label Content="мин" Style="{StaticResource CinemaLabel}" FontSize="18" HorizontalAlignment="Left" Margin="461,162,0,0" VerticalAlignment="Top"/>
            <TextBox x:Name="AddSessionMinuteTextBox" IsEnabled="False" HorizontalAlignment="Left" FontSize="18" Height="34" Margin="414,162,0,0" TextWrapping="Wrap" Text="" MaxLength="2" VerticalContentAlignment="Center" VerticalAlignment="Top" Width="47"/>
            <Label Content="Номер зала:" Style="{StaticResource CinemaLabel}" FontSize="20" HorizontalAlignment="Left" Margin="299,265,0,0" VerticalAlignment="Top"/>
            <ComboBox x:Name="AddSessionHallComboBox" ItemsSource="{Binding Path=Hall_number}" SelectionChanged="AddSessionHallComboBox_SelectionChanged" IsEnabled="False" HorizontalAlignment="Left" FontSize="20" Margin="393,267,0,0" VerticalAlignment="Top" Width="120"/>
            <Button Content="Назад" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Width="75" Click="GoOutFromAddSessionGrid"/>
            <Button x:Name="AddSessionButton" Content="Добавить" IsEnabled="False" FontSize="20" HorizontalAlignment="Center" Margin="349,371,325.6,0" VerticalAlignment="Top"  Click="AddSessionButton_Click" Width="119"/>
            <Button x:Name="AddSessionSeeFreeHallsButton" IsEnabled="False" Content="Посмореть свободные залы" FontSize="14" HorizontalAlignment="Center" Margin="290,221,283.6,0" VerticalAlignment="Top" Click="AddSessionSeeFreeHallsButton_Click" Width="220" />
            <Label Content="Цена билета:" Style="{StaticResource CinemaLabel}" FontSize="20" HorizontalAlignment="Left" Margin="296,311,0,0" VerticalAlignment="Top"/>
            <TextBox x:Name="AddSessionPriceTextBox" HorizontalAlignment="Left" FontSize="20" Margin="393,311,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>

        </Grid>
    </Grid>
</Window>
