<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Классическая кино-палитра -->
    <SolidColorBrush x:Key="CinemaRed" Color="#C41E3A"/>
    <!-- Бордово-красный -->
    <SolidColorBrush x:Key="CinemaGold" Color="#FFD700"/>
    <!-- Золотой -->
    <SolidColorBrush x:Key="LightGold" Color="#FFF8DC"/>
    <!-- Светлое золото (кремовый) -->
    <SolidColorBrush x:Key="DarkRed" Color="#8B0000"/>
    <!-- Темно-красный для нажатия -->

    <Style x:Key="CinemaButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource LightGold}"/>
        <Setter Property="Foreground" Value="{StaticResource CinemaRed}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="BorderBrush" Value="{StaticResource CinemaRed}"/>
        <Setter Property="Padding" Value="20,10"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" 
                            Background="{TemplateBinding Background}" 
                            CornerRadius="8"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Эффект при наведении -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource CinemaGold}"/>
                            <Setter Property="Foreground" Value="{StaticResource CinemaRed}"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="#A83232"/>
                        </Trigger>
                        <!-- Эффект при нажатии -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#E6C200"/>
                            <Setter Property="Foreground" Value="{StaticResource DarkRed}"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource DarkRed}"/>
                        </Trigger>
                        <!-- Эффект когда кнопка отключена -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background" Value="#F5F5F5"/>
                            <Setter Property="Foreground" Value="#A0A0A0"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="#D0D0D0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>